# Database
DATABASE_URL="postgresql://user:password@localhost:5432/petorium?schema=public"

# 비밀번호 재설정 이메일 (SMTP). 미설정 시 개발 환경에서는 API 응답/로그에 재설정 URL이 포함될 수 있음.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Petorium <noreply@yourdomain.com>"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AWS S3 (Optional - for video storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""

# Cloudflare R2 (Alternative to S3)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""

# Video Processing
FFMPEG_PATH="" # Leave empty to use ffmpeg-static, or provide custom path

# Socket.io (for real-time features)
SOCKET_IO_PORT=3001
